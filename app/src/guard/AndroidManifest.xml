<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Some firmware refuses APKs that declare CATEGORY_HOME. Keep the existing component. -->
        <activity android:name="com.sogud.bananatv.MainActivity" tools:node="replace"
            android:exported="true" android:launchMode="singleTask" android:stateNotNeeded="true"
            android:excludeFromRecents="true" android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
