<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#141C31</item>
        <item name="android:colorBackground">#141C31</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">#F3F5F8</item>
        <item name="android:buttonStyle">@style/Widget.Banana.Button</item>
        <item name="android:editTextStyle">@style/Widget.Banana.Input</item>
    </style>

    <style name="Theme.MediaPanel" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">#F3F5F8</item>
        <item name="android:editTextStyle">@style/Widget.Banana.Input</item>
    </style>
    <style name="Widget.Banana.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/panel_button_bg</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/panel_button_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>
    <style name="Widget.Banana.Input" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/panel_input_bg</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#F4F5F8</item>
        <item name="android:textColorHint">#929CAA</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:drawablePadding">0dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
