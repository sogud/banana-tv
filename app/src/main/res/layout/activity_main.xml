<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#141C31">
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />
    <com.sogud.bananatv.VideoWallpaper
        android:id="@+id/videoWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:importantForAccessibility="no" />
    <View
        android:id="@+id/wallpaperShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wallpaper_shade" />
    <com.sogud.bananatv.AmbientWallpaperView
        android:id="@+id/ambientWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <LinearLayout android:id="@+id/largeClockGroup" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|start" android:layout_marginTop="76dp" android:layout_marginStart="72dp" android:layout_marginEnd="72dp"
        android:orientation="vertical" android:visibility="gone" android:importantForAccessibility="no">
        <TextClock android:id="@+id/largeClock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textSize="68sp" android:fontFamily="sans-serif-light" android:textColor="#F8FAFC" />
        <TextView android:id="@+id/largeDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="18sp" android:textColor="#F8FAFC" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="72dp" android:paddingEnd="72dp" android:paddingTop="28dp" android:paddingBottom="54dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="36dp">

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnWeather" style="@style/TopButton"
                    android:layout_width="wrap_content" android:minWidth="56dp"
                    android:text="@string/weather_title" android:drawablePadding="6dp"
                    android:contentDescription="@string/weather_title"
                    android:nextFocusDown="@+id/grid" />
                <TextClock
                    android:id="@+id/headerClock"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="8dp"
                    android:paddingEnd="18dp"
                    android:gravity="center" android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textSize="16sp" android:textColor="#F2FFFFFF" android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/btnControls" style="@style/TopButton"
                    android:layout_width="36dp" android:layout_height="36dp"
                    android:paddingStart="9dp" android:paddingEnd="9dp"
                    android:background="@drawable/control_bg"
                    android:text="" android:drawableStart="@drawable/ic_controls" android:contentDescription="@string/control_center" android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="24dp" android:paddingEnd="24dp" android:clipToPadding="false" android:clipChildren="false" android:overScrollMode="never" android:scrollbars="none" android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
