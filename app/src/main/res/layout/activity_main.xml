<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#141C31">
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />
    <com.sogud.bbtv.VideoWallpaper
        android:id="@+id/videoWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:importantForAccessibility="no" />
    <View
        android:id="@+id/wallpaperShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wallpaper_shade" />
    <com.sogud.bbtv.AmbientWallpaperView
        android:id="@+id/ambientWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="72dp" android:paddingEnd="72dp" android:paddingTop="28dp" android:paddingBottom="54dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="36dp">

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/header_glass" android:paddingStart="6dp" android:paddingEnd="6dp">
                <TextView
                    android:id="@+id/btnWeather" style="@style/TopButton"
                    android:layout_width="wrap_content" android:minWidth="72dp"
                    android:text="@string/weather_title" android:drawablePadding="6dp"
                    android:contentDescription="@string/weather_title"
                    android:nextFocusDown="@+id/grid" />
                <TextView
                    android:id="@+id/btnInputs" style="@style/TopButton"
                    android:layout_width="32dp" android:text="" android:drawableStart="@drawable/ic_input" android:contentDescription="@string/inputs"
                    android:nextFocusDown="@+id/grid" />
                <TextView
                    android:id="@+id/btnWifi" style="@style/TopButton"
                    android:layout_width="32dp" android:text="" android:drawableStart="@drawable/ic_wifi" android:contentDescription="@string/wifi"
                    android:nextFocusDown="@+id/grid" />
                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:gravity="center" android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textSize="14sp" android:textColor="#F2FFFFFF" android:fontFamily="sans-serif" />
                <TextView
                    android:id="@+id/btnSettings" style="@style/TopButton"
                    android:layout_width="32dp"
                    android:text="" android:drawableStart="@drawable/ic_settings" android:contentDescription="@string/settings" android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="24dp" android:paddingEnd="24dp" android:clipToPadding="false" android:clipChildren="false" android:overScrollMode="never" android:scrollbars="none" android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
